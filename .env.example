# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# dev | test | prod  (manage.py defaults to config.settings.dev)
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Database (docker compose: db) ---
# docker-compose publishes Postgres on host port 5433 (POSTGRES_HOST_PORT) to avoid a local install on 5432
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgres://events:events@localhost:5433/events

# --- Redis / Celery (docker compose: redis) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- JWT ---
# Defaults to DJANGO_SECRET_KEY when empty
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Payments: mock | azampay ---
PAYMENT_GATEWAY=mock
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_API_KEY=
AZAMPAY_AUTH_BASE_URL=https://authenticator-sandbox.azampay.co.tz
AZAMPAY_CHECKOUT_BASE_URL=https://sandbox.azampay.co.tz
# Secret path segment for /api/v1/webhooks/azampay/<token>/
AZAMPAY_CALLBACK_TOKEN=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# --- LLM: fake | gemini ---
LLM_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
