# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# dev | test | prod  (manage.py defaults to config.settings.dev)
DJANGO_SETTINGS_MODULE=config.settings.dev

# Proxies in front of the app (0 = none). Required in production.
DJANGO_NUM_PROXIES=0
LOG_LEVEL=INFO

# --- Request limits (number/second|min|hour|day) ---
THROTTLE_ANON=300/min
THROTTLE_USER=300/min
# Login attempts per account and per address
THROTTLE_LOGIN=10/min
THROTTLE_LOGIN_IP=60/min
THROTTLE_REGISTER=60/hour
# Password codes sent per account (hour, day) and per address, and attempts to use one
THROTTLE_PASSWORD_CODE=3/hour
THROTTLE_PASSWORD_CODE_DAY=10/day
THROTTLE_PASSWORD_CODE_IP=60/hour
THROTTLE_PASSWORD_CONFIRM=10/min
THROTTLE_PASSWORD_CONFIRM_IP=60/min
# Webhook calls that fail authentication; valid ones are never limited
THROTTLE_WEBHOOK_REJECTED=30/min

# --- Database (docker compose: db) ---
# docker-compose publishes Postgres on host port 5435 (POSTGRES_HOST_PORT) to avoid a local install on 5432
POSTGRES_HOST_PORT=5435
DATABASE_URL=postgres://events:events@localhost:5435/events

# --- Redis / Celery (docker compose: redis) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Host ports published by docker compose
REDIS_HOST_PORT=6379
WEB_HOST_PORT=8000

# --- JWT ---
# Defaults to DJANGO_SECRET_KEY when empty
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Payments: mock | azampay ---
PAYMENT_GATEWAY=mock
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_API_KEY=
AZAMPAY_AUTH_BASE_URL=https://authenticator-sandbox.azampay.co.tz
AZAMPAY_CHECKOUT_BASE_URL=https://sandbox.azampay.co.tz
# Secret path segment for /api/v1/webhooks/azampay/<token>/
AZAMPAY_CALLBACK_TOKEN=

# --- WhatsApp Cloud API (Meta): fake | whatsapp ---
MESSAGING_PROVIDER=fake
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v26.0
# Approved templates, in en and sw, for notifications outside the 24 h window (empty = not sent).
# Body variables: new_order {{1}} reference {{2}} event date {{3}} total;
# order_status {{1}} reference {{2}} status {{3}} total; payment_failed {{1}} reference {{2}} amount
WHATSAPP_TEMPLATE_NEW_ORDER=
WHATSAPP_TEMPLATE_ORDER_STATUS=
WHATSAPP_TEMPLATE_PAYMENT_FAILED=
# Password codes: an approved AUTHENTICATION template with a copy-code button, in en and sw.
# Required in production. With MESSAGING_PROVIDER=fake any name works; in DEBUG the worker prints the code.
WHATSAPP_TEMPLATE_AUTH_CODE=auth_code

# --- LLM: fake | gemini ---
LLM_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
